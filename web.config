<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Prevent IIS from replacing backend JSON responses with HTML error pages -->
    <httpErrors existingResponse="PassThrough" />
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
